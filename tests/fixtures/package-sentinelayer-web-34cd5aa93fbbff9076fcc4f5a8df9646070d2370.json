{
  "name": "sentinelayer-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:docs": "tsx scripts/generate-docs-assets.ts",
    "check:public-doc-safety": "node scripts/check-public-doc-safety.mjs",
    "prerender:docs": "tsx scripts/prerender-docs.ts",
    "build": "npm run generate:docs && tsc -b && vite build && npm run prerender:docs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:baseline": "playwright test tests/e2e/baseline --project=chromium",
    "test:e2e:audit": "playwright test tests/e2e/baseline tests/e2e/audit --project=chromium",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.4",
    "@stripe/react-stripe-js": "5.6.0",
    "@stripe/stripe-js": "8.8.0",
    "@tanstack/react-query": "5.90.20",
    "@tanstack/react-virtual": "3.13.24",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "12.34.3",
    "lucide-react": "0.563.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.6.5",
    "react-router-dom": "6.30.4",
    "recharts": "3.7.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.4.0"
  },
  "overrides": {
    "flatted": "3.4.2",
    "esbuild": "0.28.1",
    "ws": "8.21.0",
    "js-yaml": "4.3.2",
    "minimatch": "10.2.5",
    "nanoid": "3.3.18"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.58.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.10",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.24",
    "@vitejs/plugin-react": "5.1.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "happy-dom": "20.8.9",
    "postcss": "8.5.23",
    "tailwindcss": "3.4.17",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vite": "7.3.7",
    "vitest": "4.1.8"
  }
}
